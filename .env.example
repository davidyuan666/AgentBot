# DeepSeek API
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# Telegram
TELEGRAM_TOKEN=your_telegram_token_here

# Slack (重要！)
SLACK_ENABLED=true
SLACK_BOT_TOKEN=xoxb-你的bot-token
SLACK_SIGNING_SECRET=你的signing-secret
SLACK_APP_TOKEN=xapp-你的app-token
# 发送 task.md 结果到哪个 channel（例如：#general 或 channel id: C0123456789）
SLACK_TASK_CHANNEL=

# task.md runner
# task 文件路径（相对或绝对路径）
TASK_MD_PATH=task.md
# 启动时是否自动执行一次 task.md 并发送到 Slack（需要配置 SLACK_TASK_CHANNEL）
TASK_MD_RUN_ON_STARTUP=false

# QQ (CQHTTP)
QQ_ENABLED=false
QQ_ACCESS_TOKEN=your_qq_access_token
CQHTTP_HOST=127.0.0.1
CQHTTP_PORT=5700

# WeChat
WECHAT_ENABLED=false

# Logging
LOG_LEVEL=INFO